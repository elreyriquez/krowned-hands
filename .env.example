# Krowned Hands — environment variables
# Copy to `.env.local` and fill in values before running.

# Optional — Calendly embed URL for `/book`.
# When set, the public booking page uses Calendly as source of truth.
# Example: https://calendly.com/your-handle/your-event
NEXT_PUBLIC_CALENDLY_BOOKING_URL=
# Optional — Calendly webhook signing key (recommended).
# Set this if you enable webhook syncing at /api/webhooks/calendly.
CALENDLY_WEBHOOK_SIGNING_KEY=

# PostgreSQL — required in production (e.g. Railway Postgres). When set, all
# reservations are stored in the database (survives deploys). Omit locally to
# use `.data/bookings.json` instead.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Required for /admin login
ADMIN_USERNAME=krownedhands
ADMIN_PASSWORD=change-me-please
# Optional — used to sign the admin cookie. If unset, ADMIN_PASSWORD is used.
ADMIN_SESSION_SECRET=

# Optional — get an email when a new reservation arrives (Resend)
# https://resend.com
RESEND_API_KEY=
BOOKINGS_EMAIL=krownedhands@gmail.com
BOOKINGS_FROM_EMAIL=krownedhands@gmail.com

# Optional — generic webhook (Zapier, Make, n8n, Slack Incoming Webhook, etc.)
# POSTs the full booking JSON. Leave unset if not used.
BOOKINGS_WEBHOOK_URL=
