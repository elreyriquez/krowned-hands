# Krowned Hands — environment variables
# Copy to `.env.local` and fill in values before running.

# `/book` uses our BookingForm by default; submissions POST /api/bookings and sync to
# Calendly via Scheduling API (POST /invitees) when token + event type URIs are set.

# Optional — show Calendly iframe above the form (set to true to enable).
NEXT_PUBLIC_USE_CALENDLY_EMBED=false
NEXT_PUBLIC_CALENDLY_BOOKING_URL=

# Calendly Scheduling API — API URIs from GET https://api.calendly.com/event_types
# One URI for all sessions, or per duration:
CALENDLY_EVENT_TYPE_URI=
# CALENDLY_EVENT_TYPE_URI_KROWNED_RESET_60=
# CALENDLY_EVENT_TYPE_URI_KROWNED_RESTORE_90=
# CALENDLY_EVENT_TYPE_URI_KROWNED_RENEW_120=

# Location kind for POST /invitees (required for many event types). Examples:
# ask_invitee, outbound_call, physical, phone_call — must match the Calendly event type.
# Set to omit or none to omit the location object (only if your event type allows it).
CALENDLY_BOOKING_LOCATION_KIND=ask_invitee
# Required for API-based Calendly sync/reconciliation.
CALENDLY_API_TOKEN=
# Optional — Calendly webhook signing key (recommended).
# Set this if you enable webhook syncing at /api/webhooks/calendly.
CALENDLY_WEBHOOK_SIGNING_KEY=
# Optional fallback auth for webhook endpoint if signing key is unavailable.
# If set, send as `x-kh-webhook-token` header or `?token=...` on webhook URL.
CALENDLY_WEBHOOK_TOKEN=

# PostgreSQL — required in production (e.g. Railway Postgres). When set, all
# reservations are stored in the database (survives deploys). Omit locally to
# use `.data/bookings.json` instead.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Required for /admin login
ADMIN_USERNAME=krownedhands
ADMIN_PASSWORD=change-me-please
# Optional — used to sign the admin cookie. If unset, ADMIN_PASSWORD is used.
ADMIN_SESSION_SECRET=

# Optional — get an email when a new reservation arrives (Resend)
# https://resend.com
RESEND_API_KEY=
# Inbox (can be gmail — delivery destination).
BOOKINGS_EMAIL=krownedhands@gmail.com
# From MUST be on a domain you verify at https://resend.com/domains (@gmail.com → 403).
# BOOKINGS_FROM_EMAIL=bookings@your-verified-domain.com

# Optional — generic webhook (Zapier, Make, n8n, Slack Incoming Webhook, etc.)
# POSTs the full booking JSON. Leave unset if not used.
BOOKINGS_WEBHOOK_URL=
